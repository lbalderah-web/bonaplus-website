{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/fabricante-productos-limpieza/index.html",
      "destination": "/fabricante-productos-limpieza/",
      "permanent": true
    },
    {
      "source": "/exportaciones/index.html",
      "destination": "/exportaciones/",
      "permanent": true
    },
    {
      "source": "/en/index.html",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/empresa/index.html",
      "destination": "/empresa/",
      "permanent": true
    },
    {
      "source": "/guia-mayoristas/index.html",
      "destination": "/guia-mayoristas/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mayoristas/index.html",
      "destination": "/mayoristas/",
      "permanent": true
    },
    {
      "source": "/productos/calzado/index.html",
      "destination": "/productos/calzado/",
      "permanent": true
    },
    {
      "source": "/productos/cloro/index.html",
      "destination": "/productos/cloro/",
      "permanent": true
    },
    {
      "source": "/productos/desinfectante/index.html",
      "destination": "/productos/desinfectante/",
      "permanent": true
    },
    {
      "source": "/productos/lavaplatos/index.html",
      "destination": "/productos/lavaplatos/",
      "permanent": true
    },
    {
      "source": "/productos/rinse/index.html",
      "destination": "/productos/rinse/",
      "permanent": true
    },
    {
      "source": "/productos/shampoo/index.html",
      "destination": "/productos/shampoo/",
      "permanent": true
    },
    {
      "source": "/productos/vainilla/index.html",
      "destination": "/productos/vainilla/",
      "permanent": true
    },
    {
      "source": "/productos/vinagre/index.html",
      "destination": "/productos/vinagre/",
      "permanent": true
    },
    {
      "source": "/productos-cuidado-personal/index.html",
      "destination": "/productos-cuidado-personal/",
      "permanent": true
    },
    {
      "source": "/productos-limpieza/index.html",
      "destination": "/productos-limpieza/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "trailingSlash": true
}
